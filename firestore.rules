rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns a document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to get user's role in a gym
    function getUserGymRole(gymId) {
      let staffDoc = get(/databases/$(database)/documents/gyms/$(gymId)/staff/$(request.auth.uid));
      return staffDoc != null ? staffDoc.data.role : null;
    }
    
    // Helper function to check if user is staff of a gym
    function isGymStaff(gymId) {
      let role = getUserGymRole(gymId);
      return role != null && role in ['OWNER', 'MANAGER', 'EMPLOYEE'];
    }
    
    // Helper function to check if user is owner of a gym
    function isGymOwner(gymId) {
      return getUserGymRole(gymId) == 'OWNER';
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read and write their own user document
      allow read, write: if isOwner(userId);
    }
    
    // Gyms collection
    match /gyms/{gymId} {
      // Staff can read their gym's document
      allow read: if isAuthenticated() && isGymStaff(gymId);
      
      // Only owners can create/update gym documents (for now)
      // In production, you might want to allow managers to update certain fields
      allow create: if isAuthenticated() && isGymOwner(gymId);
      allow update: if isAuthenticated() && isGymOwner(gymId);
      allow delete: if isAuthenticated() && isGymOwner(gymId);
      
      // Permission sets subcollection
      match /permissionSets/{setId} {
        // Staff can read permission sets
        allow read: if isAuthenticated() && isGymStaff(gymId);
        
        // Only owners can write permission sets
        allow write: if isAuthenticated() && isGymOwner(gymId);
      }
      
      // Staff subcollection
      match /staff/{userId} {
        // Staff can read staff documents for their gym
        allow read: if isAuthenticated() && isGymStaff(gymId);
        
        // Only owners can write staff documents
        allow write: if isAuthenticated() && isGymOwner(gymId);
      }
      
      // Plans subcollection (for Milestone 2)
      match /plans/{planId} {
        // Staff can read plans
        allow read: if isAuthenticated() && isGymStaff(gymId);
        
        // Only staff with appropriate permissions can write plans
        // For now, owners and managers can write
        // In production, check permission toggles
        allow write: if isAuthenticated() && 
          (isGymOwner(gymId) || getUserGymRole(gymId) == 'MANAGER');
      }
      
      // Members subcollection (for Milestone 2)
      match /members/{memberId} {
        // Staff can read members
        allow read: if isAuthenticated() && isGymStaff(gymId);
        
        // Members can read their own member document (for member portal)
        allow read: if isAuthenticated() && 
          resource.data.email == request.auth.token.email;
        
        // Only staff with appropriate permissions can write members
        // For now, owners and managers can write
        // In production, check permission toggles
        allow write: if isAuthenticated() && 
          (isGymOwner(gymId) || getUserGymRole(gymId) == 'MANAGER');
      }
      
      // Subscriptions subcollection (for Milestone 2)
      // Server-only writes, clients can only read
      match /subscriptions/{subscriptionId} {
        allow read: if isAuthenticated() && isGymStaff(gymId);
        // No client writes allowed - server-only
        allow write: if false;
      }
      
      // Invites subcollection
      match /invites/{inviteId} {
        // Staff can read invites
        allow read: if isAuthenticated() && isGymStaff(gymId);
        
        // Only owners and managers can create invites
        allow create: if isAuthenticated() && 
          (isGymOwner(gymId) || getUserGymRole(gymId) == 'MANAGER');
        
        // Only owners can update/delete invites
        allow update, delete: if isAuthenticated() && isGymOwner(gymId);
      }
      
      // Transactions subcollection (for future use)
      match /transactions/{txnId} {
        // Staff can read transactions
        allow read: if isAuthenticated() && isGymStaff(gymId);
        // No client writes allowed - server-only
        allow write: if false;
      }
      
      // Notifications subcollection (for future use)
      match /notifications/{notifId} {
        // Staff can read notifications
        allow read: if isAuthenticated() && isGymStaff(gymId);
        // No client writes allowed - server-only
        allow write: if false;
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


